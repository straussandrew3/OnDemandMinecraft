# Copy this file to decommission.env and fill in your real values.
# decommission.env is for local use only -- do not commit it (it's gitignored).

AWS_REGION=us-east-1
INSTANCE_ID=i-yourInstanceIdHere
ACCOUNT_ID=123456789012
BUDGET_NAME=YourBudgetNameHere

# Optional, only needed if you want the script to offer to delete these too
KEY_PAIR_NAME=
SECURITY_GROUP_NAME=
